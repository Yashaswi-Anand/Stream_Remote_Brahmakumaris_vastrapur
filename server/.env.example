# Copy to .env for local testing on this PC. On the live server set these as environment variables instead.
PORT=8787
# PUBLIC_URL=https://stream.yourdomain.com
# SETUP_CODE=choose-a-long-random-code
# REQUIRE_HTTPS=true
# MySQL (live server). Leave DB_HOST unset to use a local file in server/data.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# Folder with the desktop app installers offered on the Download page (relative to server/).
# Put Zoom-Stream-Automation-Setup-X.Y.Z.exe and ...-Portable-X.Y.Z.exe here; the newest version is offered.
# DOWNLOADS_DIR=downloads
