{
  "name": "zoom-stream-automation",
  "productName": "Zoom Stream Automation",
  "version": "2.4.1",
  "description": "Automates Zoom meetings, YouTube live streaming, image sharing and screen sharing on Windows.",
  "author": "Zoom Stream Automation",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "npm run build:renderer && electron-builder --win nsis --x64",
    "rules": "node firebase/build-rules.js",
    "test:firebase": "node firebase/test-emulators.js",
    "web:local": "node firebase/local.js",
    "deploy": "node firebase/build-rules.js && npx --yes firebase-tools@15.34.2 deploy --only hosting,database"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.zoomstreamautomation.app",
    "productName": "Zoom Stream Automation",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/services/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zoom Stream Automation",
      "uninstallDisplayName": "Zoom Stream Automation",
      "include": "build/installer.nsh",
      "artifactName": "Zoom-Stream-Automation-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Zoom-Stream-Automation-Portable-${version}.exe",
      "unpackDirName": false
    }
  }
}
